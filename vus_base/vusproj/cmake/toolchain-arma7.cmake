#Tbox-5G

set(CMAKE_SYSTEM_NAME Linux)

set(CUSTOM_CMAKE_SYSTEM_NAME arma7)

set(ARMV7_FLOAT_FLAGS "-march=armv7-a -mfpu=neon -mfloat-abi=softfp")

set(CMAKE_C_FLAGS_INIT "${ARMV7_FLOAT_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${ARMV7_FLOAT_FLAGS}")
set(CMAKE_ASM_FLAGS_INIT "${ARMV7_FLOAT_FLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${ARMV7_FLOAT_FLAGS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${ARMV7_FLOAT_FLAGS}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${ARMV7_FLOAT_FLAGS}")

##代码运行时目录，目录以 / 结尾
# set(ADM_RUNTIME_ROOT_DIR "/data/admnv/")

# 配置各种服务的开关
set(CUSTOM_HOST_SERVICE_SUPPORT ON)
set(CUSTOM_TRANS_SERVICE_SUPPORT ON)
set(CUSTOM_DPO_SERVICE_SUPPORT ON)
set(CUSTOM_UCL_SERVICE_SUPPORT ON)
set(CUSTOM_VDI_SERVICE_SUPPORT OFF)
set(CUSTOM_HMI_CLIENT_SUPPORT OFF)


# 动态链接开关
set(CUSTOME_USE_DLSYM ON)
